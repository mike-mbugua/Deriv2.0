# ── OANDA practice account credentials ───────────────────────────
OANDA_API_KEY=98751d080c991291b8861fa9621a0671-2f257c8fcbd2d43de585b1352db462db
OANDA_ACCOUNT_ID=101-011-39288762-001
OANDA_PRACTICE=true        # set to false only for live account



# ── Transaction costs ─────────────────────────────────────────────
TC=0.00007                 # ~0.7 pip per side (typical major spread)

# ── Strategy parameters ───────────────────────────────────────────
SMA_S=50
SMA_L=200
CON_WINDOW=3
BOLL_SMA=30
BOLL_DEV=2.0

# ── Regime detection ──────────────────────────────────────────────
ADX_PERIOD=14
ADX_THRESHOLD=25.0
HURST_LAGS=30

# ── Risk management ───────────────────────────────────────────────
RISK_PCT=0.1              # % of NAV risked per trade
SL_ATR_MULT=1.5            # stop loss  = 1.5 × ATR(14)
TP_ATR_MULT=2.5            # take profit = 2.5 × ATR(14)  → R:R ≈ 1.67
MAX_POSITIONS=3            # max concurrent open positions
MAX_DAILY_LOSS=3.0         # halt trading if daily loss > 3%

# ── Paper trader ──────────────────────────────────────────────────
INITIAL_BALANCE=50
UNIT_SIZE=1000
LOOP_INTERVAL=300          # seconds between ticks in live mode (5 min default)

# ── Historical data ───────────────────────────────────────────────
HISTORY_BARS=2500          # ~10 years of daily data

# ── ML session model ──────────────────────────────────────────────
ML_FEATURE_LAGS=5
ML_MIN_HIT_RATIO=0.52      # minimum directional accuracy to keep a session hour
